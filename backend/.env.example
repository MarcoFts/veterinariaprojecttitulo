# ==============================================================================
# VetCare Backend — Plantilla de Variables de Entorno (SIN SECRETOS REALES)
# ==============================================================================
SECRET_KEY=replace-with-django-secret-key
DEBUG=False
ALLOWED_HOSTS=tu-backend.onrender.com,localhost,127.0.0.1

# PostgreSQL en la nube (Render PostgreSQL / Supabase / Neon vía DATABASE_URL)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB_NAME

# Cifrado en reposo de secretos TOTP (Fernet 32 bytes base64 urlsafe)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=replace-with-fernet-key

# CORS / CSRF (URL de tu frontend en Vercel)
CORS_ALLOWED_ORIGINS=https://veterinariaprojecttitulo.vercel.app
CSRF_TRUSTED_ORIGINS=https://veterinariaprojecttitulo.vercel.app

# Correo SMTP
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password
DEFAULT_FROM_EMAIL=tu-correo@gmail.com

# Política MFA (opcional, valores por defecto MEJ-02)
MFA_ENABLED_DEFAULT=True
MFA_GRACE_PERIOD_DAYS=15
MFA_TRUSTED_DEVICE_HOURS=12
